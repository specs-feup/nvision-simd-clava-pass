{
  "name": "simd-clava-pass",
  "type": "module",
  "version": "1.0.0",
  "main": "dist/js/index.js",
  "files": [
    "src",
    "test",
    ".gitignore",
    "jest.config.js",
    "package-lock.json",
    "package.json",
    "tsconfig.jest.json",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit src",
    "test:calls": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit -- src/utils/calls.test.ts",
    "test:loopvalidation": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit -- src/loopvalidation.test.ts",
    "test:constprop": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit -- src/constprop/constprop.test.ts",
    "test:search": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit -- src/utils/search.test.ts",
    "test:propandfold": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit -- src/constprop/propandfold.test.ts",
    "test:forloop": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit -- src/pass.test.ts",
    "test:cfg": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit -- src/cfg/*.test.ts",
    "test:cfg:search": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit -- src/cfg/search.test.ts",
    "test:cfg:writes": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit -- src/cfg/writes.test.ts",
    "clear": "rm -rf dist",
    "clearall": "rm -rf dist node_modules package-lock.json",
    "build": "tsc",
    "forloop": "npx clava classic dist/js/index.js -j -p src/input/forloop.c -o dist/",
    "compileforloop": "gcc -o dist/forloop src/input/forloop.c && gcc -o dist/modifiedforloop dist/woven_code/forloop.c",
    "outputforloop": "echo 'normal forloop: ' && dist/forloop && echo 'modified forloop: ' && dist/modifiedforloop",
    "buildrunforloop": "npm run clear && npm run build && npm run forloop",
    "buildruncompileforloop": "npm run clear && npm run build && npm run forloop && npm run compileforloop && npm run outputforloop"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@specs-feup/clava": "3.0.17",
    "@specs-feup/clava-code-transforms": "^1.0.0",
    "@specs-feup/flow": "^1.0.3",
    "@specs-feup/clava-flow": "^1.0.1",
    "@specs-feup/clava-visualization": "1.0.5",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4"
  }
}